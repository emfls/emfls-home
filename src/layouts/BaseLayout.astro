---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { title = site.name, description = site.description, type = 'website', image = '/og-home.svg', noindex = false, jsonLd } = Astro.props;
const pathname = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonical = new URL(pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const defaultJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.description };
const structuredData = jsonLd ?? defaultJsonLd;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><meta name="google-site-verification" content="jmItycse5k8ak6mbGftrdO74Si7-010A0JckultrQIs" />{noindex && <meta name="robots" content="noindex,follow" />}<link rel="canonical" href={canonical} /><meta property="og:type" content={type} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageUrl} /><meta property="og:site_name" content={site.name} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} /><meta name="theme-color" content="#f7f5ef" /><link rel="icon" href="/favicon.svg" /><script type="application/ld+json" set:html={JSON.stringify(structuredData)} />{import.meta.env.PROD && <script is:inline>if (window.location.hostname === 'home.emfls.com') { const script = document.createElement('script'); script.async = true; script.src = 'https://www.googletagmanager.com/gtag/js?id=G-3250GECR4K'; document.head.appendChild(script); window.dataLayer = window.dataLayer || []; function gtag(){window.dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-3250GECR4K'); }</script>}</head><body><a class="skip-link" href="#main">본문으로 건너뛰기</a><Header /><main id="main"><slot /></main><Footer /></body></html>
