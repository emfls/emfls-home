---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/site';
---
<BaseLayout title="페이지를 찾을 수 없습니다 | 집관리 매뉴얼" noindex><div class="shell page-intro"><span class="eyebrow">404 / NOT FOUND</span><h1>이 페이지는<br />아직 찾지 못했어요.</h1><p>주소가 바뀌었거나 삭제된 페이지일 수 있습니다. 집관리 매뉴얼의 첫 화면에서 다시 찾아보세요.</p></div><div class="shell prose"><p><a class="text-link" href="/">← 홈으로 돌아가기</a></p><h2>카테고리에서 찾기</h2><ul>{categories.slice(0, 5).map(category=><li><a class="text-link" href={`/category/${category.slug}/`}>{category.name} ↗</a></li>)}</ul></div></BaseLayout>
