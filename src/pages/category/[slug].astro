---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { categories, site } from '../../data/site'; import { guides } from '../../data/guides';
export function getStaticPaths(){return categories.map(category=>({params:{slug:category.slug},props:{category}}));}
const { category }=Astro.props; const items=guides.filter(g=>g.category===category.slug);
---
<BaseLayout title={`${category.name} | ${site.name}`} description={category.description}><div class="shell page-intro"><span class="eyebrow">CATEGORY / {category.slug}</span><h1>{category.name}</h1><p>{category.description}. 증상을 보고 먼저 확인할 것과 직접 할 수 있는 작업을 구분해 안내합니다.</p></div><div class="shell section"><div class="section-head"><h2>이 항목의 매뉴얼</h2><p>{items.length ? `${items.length}개의 가이드` : '준비 중인 가이드'}</p></div>{items.length ? <div class="guide-list">{items.map((guide,i)=><a class="guide-row" href={`/guides/${guide.slug}/`}><span class="index">0{i+1}</span><span><h3>{guide.title}</h3><p>{guide.summary}</p></span><span class="read">읽어보기 ↗</span></a>)}</div> : <div class="notice">이 카테고리의 첫 매뉴얼을 준비하고 있습니다. 다른 항목에서 집관리의 기본 점검 순서를 먼저 확인해보세요.</div>}</div></BaseLayout>
