---
import BaseLayout from '../../layouts/BaseLayout.astro'; import GuideMeta from '../../components/GuideMeta.astro'; import { guides } from '../../data/guides'; import { categories, site } from '../../data/site';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const { guide }=Astro.props; const category=categories.find(c=>c.slug===guide.category); const relatedGuides=guide.related.map(slug=>guides.find(item=>item.slug===slug)).filter((item): item is (typeof guides)[number] => Boolean(item)); const title=`${guide.title} | ${site.name}`; const canonical=new URL(`/guides/${guide.slug}/`, site.url).href; const jsonLd=[{ '@context':'https://schema.org', '@type':'Article', headline:guide.title, description:guide.summary, url:canonical, mainEntityOfPage:canonical, author:{ '@type':'Organization', name:site.name }, isPartOf:{ '@type':'WebSite', name:site.name, url:site.url } },{ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'홈', item:`${site.url}/` },{ '@type':'ListItem', position:2, name:category?.name ?? '가이드', item:new URL(`/category/${guide.category}/`, site.url).href },{ '@type':'ListItem', position:3, name:guide.title, item:canonical }]}];
---
<BaseLayout title={title} description={guide.summary} type="article" jsonLd={jsonLd}><div class="shell page-intro"><span class="eyebrow">{category?.name} / GUIDE</span><h1>{guide.title}</h1><p>{guide.summary}</p></div><div class="shell guide-layout"><article><GuideMeta difficulty={guide.difficulty} time={guide.time} /><div class="notice"><strong>먼저 읽어보세요</strong><br />작업 전 주변을 정리하고, 이상이 느껴지면 무리하지 말고 중단하세요. 전기·가스·누수처럼 안전과 연결된 문제는 전문가 판단이 우선입니다.</div><section class="manual-section precheck"><h2>먼저 확인할 것</h2><ul>{guide.checkFirst.map(item=><li>{item}</li>)}</ul></section><section class="manual-section causes"><h2>주요 원인</h2><ul>{guide.causes.map(item=><li>{item}</li>)}</ul></section><section class="manual-section materials"><h2>준비물</h2><ul>{guide.materials.map(item=><li>{item}</li>)}</ul></section><section class="manual-section"><h2>단계별로 확인하기</h2><ol class="steps">{guide.steps.map(item=><li>{item}</li>)}</ol></section><section class="manual-section avoid"><h2>하지 말아야 할 것</h2><ul>{guide.avoid.map(item=><li>{item}</li>)}</ul></section><section class="manual-section expert"><h2>전문가를 불러야 하는 경우</h2><p>{guide.expert}</p></section><section class="manual-section prevention"><h2>예방 방법</h2><ul>{guide.prevention.map(item=><li>{item}</li>)}</ul></section>{guide.faq?.length ? <section class="manual-section faq-section"><h2>자주 묻는 질문</h2><dl class="faq">{guide.faq.map(item=><><dt>{item.question}</dt><dd>{item.answer}</dd></>)}</dl></section> : null}{relatedGuides.length ? <section class="manual-section related-section"><h2>이어 읽기</h2><ul class="related-links">{relatedGuides.map(item=><li><a class="text-link" href={`/guides/${item.slug}/`}>{item.title} ↗</a></li>)}</ul></section> : null}</article><aside class="side-note"><strong>이 매뉴얼의 범위</strong>일상적인 기본 점검을 위한 안내입니다. 건물 구조나 설비 상태에 따라 방법이 달라질 수 있습니다.<br /><br /><a href={`/category/${guide.category}/`}>← {category?.name}의 다른 글</a></aside></div></BaseLayout>
